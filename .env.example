# PostgreSQL
POSTGRES_DB=clipfinder
POSTGRES_USER=clipfinder
POSTGRES_PASSWORD=clipfinder
POSTGRES_PORT=5432

# Public ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend settings
CORS_ORIGINS=http://localhost:3000
YOUTUBE_API_KEY=

# Railway Bucket (deixe vazio no desenvolvimento local)
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_URL_STYLE=virtual
MAX_UPLOAD_SIZE_GB=10
