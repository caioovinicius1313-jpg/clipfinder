# PostgreSQL
POSTGRES_DB=clipfinder
POSTGRES_USER=clipfinder
POSTGRES_PASSWORD=clipfinder
POSTGRES_PORT=5432

# Public ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend settings
CORS_ORIGINS=http://localhost:3000
YOUTUBE_API_KEY=
YOUTUBE_RANKING_METRIC=view_delta
YOUTUBE_RANKING_CANDIDATE_LIMIT=25
YOUTUBE_RANKING_TOP_LIMIT=10
YOUTUBE_RANKING_MAX_HASHTAGS_PER_RUN=80
YT_DLP_TIMEOUT_SECONDS=60
# Cookies do YouTube em formato Netscape, convertidos para Base64. Nunca envie ao GitHub.
YOUTUBE_COOKIES_BASE64=
YOUTUBE_USER_AGENT=

# Railway Bucket (deixe vazio no desenvolvimento local)
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_URL_STYLE=virtual
MAX_UPLOAD_SIZE_GB=10
